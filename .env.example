# Ollama 服務設定
OLLAMA_MODEL=qwen2.5:7b

# LLM 模型名稱設定
ANALYZER_MODEL=qwen2.5:7b
GENERATOR_MODEL=qwen2.5:7b
VISION_MODEL=llava

# Embedding 語意向量模型設定
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2

# ChromaDB 相關設定
CHROMA_COLLECTION_NAME=ads_collection

# [PROJ_ROOT] 改成專案根目錄

CHROMA_DB_PATH=[PROJ_ROOT]/data/chroma_db

# SQLite3 相關設定
SQLITE_DB_FILE=[PROJ_ROOT]/data/scam_database.db

# 專案根目錄
PROJ_ROOT=[PROJ_ROOT]

# 資料集儲存路徑
DATASET_PATH=[PROJ_ROOT]/chroma_initiator\dataset

# Google GenAI (Imagen 4) 圖片生成設定
# 請至 https://aistudio.google.com/apikey 取得你的 API 金鑰
GOOGLE_API_KEY=
# 可選模型：imagen-4.0-generate-001 | imagen-4.0-fast-generate-001 | imagen-4.0-ultra-generate-001
IMAGEN_MODEL=imagen-4.0-generate-001
